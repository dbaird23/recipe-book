# Google OAuth client ID (Web application) from https://console.cloud.google.com/apis/credentials
# Add http://localhost:5173 to "Authorized JavaScript origins".
# Leave unset to use the dev sign-in fallback (development only).
GOOGLE_CLIENT_ID=

# Port for the API server (default 3001)
API_PORT=3001

# Base URL used when generating invite links (default: the web dev server)
APP_URL=http://localhost:5173
