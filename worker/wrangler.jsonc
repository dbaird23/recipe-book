{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recipe-book",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  // The built SPA. Navigation requests are served straight from the asset
  // store; only the API and photo routes wake the Worker.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    // "/connect" is deliberately absent: it's a screen in the app, so the SPA
    // fallback should serve it like any other.
    "run_worker_first": ["/api/*", "/uploads/*", "/mcp", "/oauth/*", "/.well-known/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "recipe-book",
      "database_id": "06b570ab-231d-4a89-9974-b2704e56e1e7",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "recipe-book-photos"
    }
  ],

  "vars": {
    // Public (not a secret); it ships in the client bundle. Setting it
    // enables Google sign-in and disables the dev sign-in fallback.
    "GOOGLE_CLIENT_ID": "590088983636-k1d0sft1bvg8o0la2cnn59kv2j043o0f.apps.googleusercontent.com"
  },

  "observability": {
    "enabled": true
  }
}
