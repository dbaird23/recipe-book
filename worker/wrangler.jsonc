{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recipe-book",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  // The Anthropic SDK, which reads a recipe off a photograph, reaches for a
  // handful of Node built-ins on the way in.
  "compatibility_flags": ["nodejs_compat"],

  // The built SPA. "/" is served straight from the asset store, so the ordinary
  // way in never wakes the Worker.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    // A miss is a miss. The alternative, "single-page-application", answers
    // *every* unmatched path with index.html and a 200, so a stale bundle
    // reference comes back as HTML labelled as JavaScript and a missing icon
    // as HTML labelled as an image. The app navigates to exactly three paths --
    // "/", which is a real file, plus the two named below -- so there is
    // nothing left for a catch-all to catch. (Sharing a recipe links to
    // "/?r=<id>", which is still just "/".)
    "not_found_handling": "none",
    // Everything here wakes the Worker. "/connect" and "/invite/*" are screens
    // rather than endpoints: they used to arrive via the SPA fallback, and now
    // that there isn't one the Worker hands back the shell itself.
    "run_worker_first": [
      "/api/*", "/uploads/*", "/mcp", "/oauth/*", "/.well-known/*",
      "/connect", "/invite/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "recipe-book",
      "database_id": "06b570ab-231d-4a89-9974-b2704e56e1e7",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "recipe-book-photos"
    }
  ],

  "vars": {
    // Public (not a secret); it ships in the client bundle. Setting it
    // enables Google sign-in and disables the dev sign-in fallback.
    "GOOGLE_CLIENT_ID": "590088983636-k1d0sft1bvg8o0la2cnn59kv2j043o0f.apps.googleusercontent.com"
  },

  "observability": {
    "enabled": true
  }
}
